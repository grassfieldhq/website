// Cloudflare Workers project "website": the static export in out/ served as static assets, no Worker code. Cloudflare's
// Git integration (Workers Builds) runs `npx wrangler deploy` on every push to main; wrangler runs the build below first.
// Headers: public/_headers (copied to out/_headers). The site answers on its custom domains, grassfield.site and
// www.grassfield.site (owner decision of 2026-11-05), and on the workers.dev address.
{
  "name": "website",
  "compatibility_date": "2026-10-01",
  "build": { "command": "npm ci && npm run build" },
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "grassfield.site", "custom_domain": true },
    { "pattern": "www.grassfield.site", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": false
}

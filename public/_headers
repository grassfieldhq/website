# Cloudflare response headers for the static assets (https://developers.cloudflare.com/workers/static-assets/headers/).
# The Content Security Policy itself is a <meta> in each page (scripts/csp.mjs); frame-ancestors only works as a header.
# X-Robots-Tag closes the site to crawlers until the public launch, like robots.txt and the pages' noindex.

/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()
  Cross-Origin-Opener-Policy: same-origin
  X-Robots-Tag: noindex, nofollow

# File names carry a hash of their content: cache them for good.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/shots/*
  Cache-Control: public, max-age=31536000, immutable
